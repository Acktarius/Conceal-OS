#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: conceal-os
    username: conceal
    password: "$6$JD188xTKCSdljcs6$zjTC/4D0SaEJ0DOsYncANweHM6GkLisxxxHoOLyxPZfRfseQnrv92ww59vCccPRNzcqIm16/qLqHRq0W3s7/80"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []

  locale: en_CA.UTF-8
  keyboard:
    layout: us

  updates: security
  
  network:
    version: 2
    ethernets:
      eth0:
        dhcp4: true
        optional: true
      enp0s3:
        dhcp4: true
        optional: true
      ens3:
        dhcp4: true
        optional: true
      any:
        match:
          name: en*
        dhcp4: true
        optional: true
  
  storage:
    layout:
      name: lvm
    swap:
      size: 0

  packages:
    - openssh-server
    - qemu-guest-agent
    - cloud-guest-utils
    - ubuntu-desktop

  early-commands:
    - touch /tmp/autoinstall-started

  late-commands:
    - curtin in-target --target=/target -- bash -c "echo 'conceal ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/conceal"
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/conceal
    - curtin in-target --target=/target -- apt-get install -y openssh-server
    - curtin in-target --target=/target -- systemctl enable ssh || curtin in-target --target=/target -- systemctl enable sshd
    - curtin in-target --target=/target -- systemctl enable ssh.socket || true
    - curtin in-target --target=/target -- netplan generate
    - curtin in-target --target=/target -- netplan apply
