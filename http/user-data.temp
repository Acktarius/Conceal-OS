#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: conceal-os
    username: conceal
    password: "$6$JD188xTKCSdljcs6$zjTC/4D0SaEJ0DOsYncANweHM6GkLisxxxHoOLyxPZfRfseQnrv92ww59vCccPRNzcqIm16/qLqHRq0W3s7/80"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []

  locale: en_CA.UTF-8
  keyboard:
    layout: us

  updates: security
  
  network:
    version: 2
    ethernets:
      any:
        match:
          name: "en*"
        dhcp4: true
        dhcp-identifier: mac
  
  storage:
    layout:
      name: lvm
    swap:
      size: 0

  packages:
    - openssh-server
    - qemu-guest-agent
    - cloud-guest-utils

  late-commands:
    - curtin in-target --target=/target -- bash -c "echo 'conceal ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/conceal"
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/conceal
